{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/images/kabutor.png",
    "width": 40,
    "padding": {
      "top": 1,
      "left": 3,
      "right": 4
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    {
      "type": "break"
    },

    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}",
      "color": {
        "user": "cyan",
        "host": "blue"
      }
    },

    {
      "type": "custom",
      "format": "╭─ system"
    },

    {
      "type": "os",
      "key": "│ 󰋽",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "│ 󰌢",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│ 󰡱",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ 󰏖",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "│ 󰢖",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "│ 󰍹",
      "keyColor": "blue",
      "compactType": "scaled"
    },

    {
      "type": "custom",
      "format": "├─ hardware"
    },

    {
      "type": "cpu",
      "key": "│ ",
      "keyColor": "cyan",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "│ 󰍛",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "│ 󰍛",
      "keyColor": "magenta"
    },
    {
      "type": "swap",
      "key": "│ 󰓡",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "│ 󰍶",
      "keyColor": "yellow"
    },
    {
      "type": "battery",
      "key": "│ 󰂎",
      "keyColor": "green"
    },

    {
      "type": "custom",
      "format": "├─ session"
    },

    {
      "type": "de",
      "key": "│ 󰯞",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔",
      "keyColor": "blue"
    },

    {
      "type": "custom",
      "format": "╰─"
    },

    {
      "type": "colors",
      "symbol": "circle"
    },

    {
      "type": "break"
    }
  ]
}
